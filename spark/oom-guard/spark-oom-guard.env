# /etc/default/spark-oom-guard — konfigurace spark-oom-guard (viz spark/README.md)

# Pořadí obětí = kdo na SPARKu drží nejvíc GPU paměti a koho nejméně bolí ztratit.
# Chybějící nebo zastavené cíle se přeskakují. docker:<jméno>, cgroup:<cesta>.
# ComfyUI běží jen jako user unit (rag-schedule s ním tak zachází); system
# unit byla duplicita a 2026-09-26 zmizela.
GUARD_TARGETS="docker:swarm-director docker:flux-kontext docker:flux-schnell docker:flux-dev cgroup:/sys/fs/cgroup/user.slice/user-1000.slice/user@1000.service/app.slice/comfyui.service docker:audio-music docker:audio-sfx docker:tune-builder docker:tune-validator docker:ocr-api docker:swarm-coder docker:swarm-coder-nim docker:swarm-rag docker:swarm-nano docker:lab docker:dev docker:translate docker:qwen36-agent docker:fallback"

# Spouštěč: platí-li kterákoli podmínka nepřetržitě danou dobu.
# Noční director (0.75) nechává ~15–20 GiB MemAvailable, takže 2 GiB je
# daleko pod normálním provozem a blízko okamžiku, kdy sshd přestane forkovat.
GUARD_MIN_AVAIL_MIB=2048
GUARD_AVAIL_FOR=3s
GUARD_PSI_FULL=15
GUARD_PSI_FULL_FOR=10s
GUARD_PSI_SOME=40
GUARD_PSI_SOME_FOR=15s

# Po zabití počkat, než se paměť uvolní, a teprve pak jít na dalšího.
GUARD_COOLDOWN=15s

# Když už není koho zabít a tlak trvá: restart (sysrq s-u-b), nejvýš jednou za hodinu.
GUARD_REBOOT=1
GUARD_REBOOT_AFTER=3m
GUARD_REBOOT_MIN_GAP=1h

GUARD_NOTIFY="runuser -u ol1n -- /home/ol1n/deploy/WorldLibraryProject/deploy/spark/notify.sh"
GUARD_DRY_RUN=0
