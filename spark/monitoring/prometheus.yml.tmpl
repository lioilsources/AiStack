# Rendered by install.sh into run/prometheus.yml (@JODA_HOST@ comes from .env).
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels: { host: SPARK }
      - targets: ["@JODA_HOST@:9100"]
        labels: { host: JODA }

  - job_name: gpu
    static_configs:
      - targets: ["127.0.0.1:9835"]
        labels: { host: SPARK }

  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
        labels: { host: SPARK }
