# Copy to .env and fill in secrets before first run.
# cp .env.example .env

# ── Auth ─────────────────────────────────────────────────────
HF_TOKEN=hf_...

# ── vLLM ─────────────────────────────────────────────────────
VLLM_VERSION=26.03.post1-py3
HF_MODEL_LAB=openai/gpt-oss-120b
HF_MODEL_DEV=nvidia/Gemma-4-31B-IT-NVFP4

# ── Cache paths (host absolute paths) ────────────────────────
# Reuse existing llm-stack caches — no re-download needed:
CACHE_LAB=/home/ol1n/llm-stack/cache/lab
CACHE_DEV=/home/ol1n/llm-stack/cache/dev
CACHE_QWEN_IMAGE=/home/ol1n/llm-stack/cache/img    # QwenImageEditPlusPipeline already here

# New downloads needed:
CACHE_FLUX=/home/ol1n/Code/Github/ai-stack/cache/flux
CACHE_QWEN_VL=/home/ol1n/Code/Github/ai-stack/cache/qwen-vl

# ── Image API ─────────────────────────────────────────────────
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
QWEN_IMAGE_MODEL_ID=Qwen/Qwen-Image-Edit-2511
FLUX_FP8=0
# Set to 0 to skip loading a pipeline (saves GPU memory):
LOAD_FLUX=1
LOAD_QWEN_IMAGE=1
# NSFW LoRA (xey/sldr_flux_nsfw_v2-studio): run `make download-flux-lora` first.
# Default is SFW; request the nsfw variant per-call with {"nsfw": true}.
LOAD_FLUX_LORA=1
FLUX_NSFW_LORA=/root/.cache/huggingface/flux/lora/lora.safetensors
FLUX_NSFW_LORA_SCALE=1.0

# ── OCR API ───────────────────────────────────────────────────
OCR_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# ── SwarmBattle LLM Stack (Pipeline B — LangGraph hybrid) ─────────────────
# Requires: make download-nemotron && make download-nemotron-coder
SWARM_VLLM_VERSION=v0.20.0

# Model IDs (swap swarm-coder to nvidia/Llama-3_3-Nemotron-Super-49B-v1 for heavier reasoning)
HF_MODEL_SWARM_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
HF_MODEL_SWARM_CODER=microsoft/Phi-4
HF_MODEL_SWARM_DIRECTOR=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
HF_MODEL_SWARM_RAG=nvidia/Llama-3.1-Nemotron-8B-UltraLong-4M-Instruct
HF_MODEL_SWARM_EMBED=intfloat/e5-mistral-7b-instruct

# Cache paths
CACHE_SWARM_NANO=/home/ol1n/llm-stack/cache/swarm-nano
CACHE_SWARM_CODER=/home/ol1n/llm-stack/cache/swarm-coder
CACHE_SWARM_DIRECTOR=/home/ol1n/llm-stack/cache/swarm-director
CACHE_SWARM_RAG=/home/ol1n/llm-stack/cache/swarm-rag
CACHE_SWARM_EMBED=/home/ol1n/llm-stack/cache/swarm-embed
CHROMADB_DATA=/home/ol1n/llm-stack/chromadb
