# Copy to .env and fill in secrets before first run.
# cp .env.example .env

# ── Auth ─────────────────────────────────────────────────────
HF_TOKEN=hf_...

# ── vLLM ─────────────────────────────────────────────────────
VLLM_VERSION=26.03.post1-py3
HF_MODEL_LAB=openai/gpt-oss-120b
HF_MODEL_DEV=nvidia/Gemma-4-31B-IT-NVFP4
HF_MODEL_TRANSLATE=Qwen/Qwen3-32B-AWQ

# ── Cache paths (host absolute paths) ────────────────────────
CACHE_LAB=/home/ol1n/deploy/AiStack/cache/gpt-oss
CACHE_DEV=/home/ol1n/deploy/AiStack/cache/gemma
CACHE_TRANSLATE=/home/ol1n/deploy/AiStack/cache/qwen3-32b

# ── Agent LLM (docker-compose.agent.yaml) — OpenClaw / PromoClown ────────────
# Rezidentní, mimo controller. Stažení: make download-agent (~23,4 GB)
HF_MODEL_AGENT=nvidia/Qwen3.6-35B-A3B-NVFP4
CACHE_AGENT=/home/ol1n/deploy/AiStack/cache/agent
AGENT_VLLM_VERSION=v0.20.0
# Podíl ze 121 GB unified paměti (~36 GB: váhy 23,4 GB + KV cache + CUDA grafy)
AGENT_GPU_MEMORY_UTILIZATION=0.30

# ── SwarmBattle LLM Stack (Pipeline B — LangGraph hybrid) ─────────────────
# Requires: make download-nemotron && make download-nemotron-coder
SWARM_VLLM_VERSION=v0.20.0

# Model IDs (swap swarm-coder to nvidia/Llama-3_3-Nemotron-Super-49B-v1 for heavier reasoning)
HF_MODEL_SWARM_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
HF_MODEL_SWARM_CODER=microsoft/Phi-4
HF_MODEL_SWARM_DIRECTOR=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
HF_MODEL_SWARM_RAG=nvidia/Llama-3.1-Nemotron-8B-UltraLong-4M-Instruct
HF_MODEL_SWARM_EMBED=intfloat/e5-mistral-7b-instruct

# Cache paths
CACHE_SWARM_NANO=/home/ol1n/llm-stack/cache/swarm-nano
CACHE_SWARM_CODER=/home/ol1n/llm-stack/cache/swarm-coder
CACHE_SWARM_DIRECTOR=/home/ol1n/llm-stack/cache/swarm-director
CACHE_SWARM_RAG=/home/ol1n/llm-stack/cache/swarm-rag
CACHE_SWARM_EMBED=/home/ol1n/llm-stack/cache/swarm-embed
CHROMADB_DATA=/home/ol1n/llm-stack/chromadb

# ── Card Forge image-tune stack (docker-compose.tune-image.yaml) ──
# Reuse existujících cache — builder = swarm-nano, validator = qwen-vl
# (validator stahuje make download-qwen-vl).
HF_MODEL_TUNE_BUILDER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
HF_MODEL_TUNE_VALIDATOR=Qwen/Qwen2.5-VL-7B-Instruct
CACHE_TUNE_BUILDER=/home/ol1n/deploy/AiStack/cache/swarm-nano
CACHE_TUNE_VALIDATOR=/home/ol1n/deploy/AiStack/cache/qwen-vl

# ── NIM Image Generation (gen-queue) ──────────────────────────
# NIM services jsou Docker-internal (flux-kontext:8000, flux-schnell:8000).
# Worker counts (one per concurrent GPU inference slot)
NIM_KONTEXT_WORKERS=1
NIM_SCHNELL_WORKERS=1
# Result TTL in seconds (default 1 h)
RESULT_TTL_SECONDS=3600

# ── OCR Stack ─────────────────────────────────────────────────
# trocr-kurrent     = 19th century Kurrent (matriky 1800–1900)
# trocr-kurrent-XVI-XVII = pre-1800 Kurrent (matriky 1790–1800)
OCR_MODEL=dh-unibe__trocr-kurrent
CACHE_OCR=/home/ol1n/llm-stack/cache/ocr

# ─────────────────────────────────────────────────────────────────────────────
# Audio — generování hudby a SFX (services/audio)
# ─────────────────────────────────────────────────────────────────────────────
# Kořen stažených vah. Ne /opt/audio: na SPARKu není passwordless sudo.
AUDIO_MODELS_PATH=/home/ol1n/dev/audio/models
# Kam se ukládají vygenerované soubory a SQLite s joby.
AUDIO_DATA_PATH=/home/ol1n/dev/audio/data

# Výchozí modely — jména musí odpovídat katalogu v services/audio/app/catalog.py.
AUDIO_MUSIC_MODEL=acestep-v15-turbo
AUDIO_SFX_MODEL=moss-soundeffect-v2

# Loudness cíle post-processingu (LUFS) a strop true peaku (dBTP).
AUDIO_MUSIC_LUFS=-16
AUDIO_SFX_LUFS=-18
AUDIO_TRUE_PEAK_DB=-1
AUDIO_OGG_QUALITY=6

# Timeouty generace v sekundách.
AUDIO_MUSIC_TIMEOUT_S=900
AUDIO_SFX_TIMEOUT_S=300

# Po kolika sekundách nečinnosti audio-sfx odloží model z paměti (0 = nikdy).
AUDIO_SFX_IDLE_UNLOAD_S=900
# Předběžné načtení SFX modelu při startu kontejneru (rychlejší první request,
# ale drží paměť i když se negeneruje).
AUDIO_SFX_PRELOAD=false

# torch.compile: u SFX ověřeno, že na GB10 jede a je skoro 2× rychlejší;
# u hudby zatím neověřeno, proto zůstává vypnutý.
AUDIO_SFX_TORCHDYNAMO_DISABLE=0
AUDIO_MUSIC_TORCHDYNAMO_DISABLE=1

# Kroky flow-match solveru u SFX. 100 = doporučení MOSS (22,5 s/efekt),
# 50 = 11,2 s, 30 = 6,7 s. Čas roste lineárně.
AUDIO_SFX_STEPS=100

# Klíč pro /v1/audio/*; prázdný = služba jede jen v interní síti a po LAN.
AUDIO_API_KEY=
